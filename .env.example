# AURA PostgreSQL
POSTGRES_DB=aura
POSTGRES_USER=aura
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# Existing Compose API connection (URL-encode the password if necessary).
# AURA_DATABASE_URL=postgresql+asyncpg://aura:<password>@db:5432/aura
# TLS, automatic renewal, password rotation and a local standby are opt-in.
# See docs/operations/DATABASE.md. Managed URLs/keys/backups live in ignored .db-ops/.
# AURA_DOCKER_SUBNET=10.250.50.0/24

# Server-only key shared by Next BFF and FastAPI. Generate with: openssl rand -hex 32
# Required for BFF mutations such as POST /api/partner. Never commit the real value.
AURA_BFF_SHARED_KEY=

# Set the real public origin when using Caddy/HTTPS.
APP_ORIGIN=http://localhost:13000

# JWT issuer settings for FastAPI. Use a separate random key from AURA_BFF_SHARED_KEY.
AURA_JWT_SIGNING_KEY=
AURA_JWT_ISSUER=aura
AURA_JWT_AUDIENCE=aura-api
