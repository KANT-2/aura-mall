AURA_APP_NAME=AURA API
AURA_API_PREFIX=/api/v1
# JWT authentication is disabled until all four settings are explicitly configured.
# Use a random 32-128 character URL-safe key, separate from the BFF shared key.
# AURA_JWT_ALGORITHM=HS256
# AURA_JWT_SIGNING_KEY=<server-only-random-key>
# AURA_JWT_ISSUER=https://issuer.example.com
# AURA_JWT_AUDIENCE=aura-api
# Exact public origins (JSON array). Empty means no direct browser mutations.
AURA_CSRF_ALLOWED_ORIGINS=[]
# Optional: provision the same random 32-128 URL-safe value as Next API_BFF_SHARED_KEY.
# AURA_BFF_SHARED_KEY=<server-only-secret>
