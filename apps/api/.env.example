AURA_APP_NAME=AURA API
AURA_API_PREFIX=/api/v1
# JWT authentication is disabled until all four settings are explicitly configured.
# Use a random 32-128 character URL-safe key, separate from the BFF shared key.
# AURA_JWT_ALGORITHM=HS256
# AURA_JWT_SIGNING_KEY=<server-only-random-key>
# AURA_JWT_ISSUER=https://issuer.example.com
# AURA_JWT_AUDIENCE=aura-api
# Explicit approved PostgreSQL URL; absent means lifecycle API storage is unavailable.
# No DDL or migrations run automatically. CRA-14 schema alignment is required first.
# AURA_DATABASE_URL=postgresql://<user>:<password>@<host>/<database>
AURA_JWT_ACCESS_TTL_SECONDS=900
AURA_REFRESH_TOKEN_TTL_SECONDS=604800
# Exact public origins (JSON array). Empty means no direct browser mutations.
AURA_CSRF_ALLOWED_ORIGINS=[]
# Optional: provision the same random 32-128 URL-safe value as Next API_BFF_SHARED_KEY.
# AURA_BFF_SHARED_KEY=<server-only-secret>
# PostgreSQL (async driver). Unset = no database; DB-backed endpoints fail closed.
# AURA_DATABASE_URL=postgresql+asyncpg://aura:<password>@127.0.0.1:5432/aura
# Alternative: read a secret file on startup. Configure only one URL source.
# AURA_DATABASE_URL_FILE=/run/aura-db-client/database-url
# Long-running API workers watch this file and validate both DB drivers before switching.
# The operator reads per-worker acknowledgements here; mount it writable for the API.
# AURA_DATABASE_RUNTIME_DIR=/run/aura-db-runtime
# Verified TLS URL, supported by SQLAlchemy/asyncpg and psycopg:
# postgresql://<user>:<password>@db/aura?sslmode=verify-full&sslrootcert=/path/to/ca.crt
