# Server-only. Mock API defaults; no NEXT_PUBLIC_ backend variables.
API_URL=http://127.0.0.1:4000
API_PREFIX=/api
API_TIMEOUT_MS=10000
API_SESSION_COOKIE=aura_mock_session

# FastAPI example, once the storefront contract is implemented:
# API_URL=http://127.0.0.1:8000
# API_PREFIX=/api/v1
# API_SESSION_COOKIE=aura_session

# Set the canonical public origin behind a reverse proxy / HTTPS termination.
# APP_ORIGIN=https://mall.example.com
