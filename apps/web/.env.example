# Server-only. Mock and FastAPI both use the same JWT authentication contract.
API_URL=http://127.0.0.1:4000
API_PREFIX=/api
API_TIMEOUT_MS=10000
API_ACCESS_COOKIE=aura_access
API_REFRESH_COOKIE=aura_refresh

# FastAPI: migrate and seed the DB, then configure AURA_JWT_* and AURA_BFF_SHARED_KEY.
# API_URL=http://127.0.0.1:8000
# API_PREFIX=/api/v1
# API_BFF_SHARED_KEY=<same server-only secret as FastAPI AURA_BFF_SHARED_KEY>
# APP_ORIGIN=https://mall.example.com
