{
  "name": "aura-mall",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "check:contract": "npm run check:contract --workspace @aura/web",
    "dev": "npm run dev --workspace @aura/web --",
    "dev:web": "npm run dev:web --workspace @aura/web --",
    "build": "npm run build --workspace @aura/web --",
    "start": "npm run start --workspace @aura/web --",
    "lint": "npm run lint --workspace @aura/web --",
    "lint:css": "npm run lint:css --workspace @aura/web --",
    "typecheck": "npm run typecheck --workspace @aura/web --",
    "test": "npm run test --workspace @aura/web --",
    "test:e2e": "npm run test:e2e --workspace @aura/web --",
    "test:e2e:jwt": "npm run test:e2e:jwt --workspace @aura/web --",
    "test:e2e:fastapi": "npm run test:e2e:fastapi --workspace @aura/web --",
    "test:e2e:visual": "npm run test:e2e:visual --workspace @aura/web --",
    "test:watch": "npm run test:watch --workspace @aura/web --",
    "mock": "npm run mock --workspace @aura/web --",
    "mock:dev": "npm run mock:dev --workspace @aura/web --",
    "start:mock": "npm run start:mock --workspace @aura/web --",
    "format": "prettier --write . && uv run --directory apps/api --locked ruff format .",
    "format:check": "prettier --check .",
    "setup:api": "uv sync --directory apps/api --locked",
    "dev:api": "uv run --directory apps/api --locked uvicorn aura_api.main:app --reload --host 127.0.0.1 --port 8000",
    "start:api": "uv run --directory apps/api --locked uvicorn aura_api.main:app --host 127.0.0.1 --port 8000",
    "lint:api": "uv run --directory apps/api --locked ruff check .",
    "format:api": "uv run --directory apps/api --locked ruff format .",
    "test:api": "uv run --directory apps/api --locked pytest",
    "check:web": "npm run lint && npm run lint:css && npm run typecheck && npm test",
    "check:api": "npm run lint:api && uv run --directory apps/api --locked ruff format --check . && npm run test:api",
    "check": "npm run format:check && npm run check:web && npm run check:api && npm run check:contract"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
